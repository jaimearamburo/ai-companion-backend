# Copy to .env and fill in real values locally. Never commit .env.
# Deployed environments read these from a secrets manager, not a file.
# Leaving a value empty (KEY=) counts as not set.

# Runtime behaviour (optional; defaults shown)
# ENVIRONMENT: development | production
ENVIRONMENT=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (DEBUG is refused in production)
LOG_LEVEL=INFO
# LOG_FORMAT: auto | console | json (auto = console in development, json in production)
LOG_FORMAT=auto

# Which region profile this worker serves: au or us (default au).
WORKER_REGION=au

# LiveKit Cloud (unpinned; each client reaches its nearest edge)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Vendor keys -------------------------------------------------------------
# Optional individually: the worker requires only the keys its region profile uses
# (src/companion/providers/regions.toml) and names any that are missing.

# Speech-to-text: Deepgram (a candidate)
DEEPGRAM_API_KEY=

# Text-to-speech: Fish Audio hosted API
FISH_API_KEY=

# LLM hosts for the scriptwriter and safety models (candidates)
GROQ_API_KEY=
# Amazon Bedrock long-term API key; BEDROCK_REGION is only used by the latency probe
BEDROCK_API_KEY=
BEDROCK_REGION=ap-southeast-2

# Only needed if an Inworld preset is used
INWORLD_API_KEY=

# Redis (shared state such as the post-call queue), Upstash, Sydney — rediss:// (TLS) URL
REDIS_URL=

# Supabase Postgres (Sydney) — Postgres connection string used by the backend's
# Python driver (not the Supabase JS/REST API)
SUPABASE_DB_URL=
