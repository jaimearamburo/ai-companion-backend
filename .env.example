# Copy to .env and fill in real values locally. Never commit .env.
# Deployed environments read these from a secrets manager, not a file.

# LiveKit Cloud (Australia-pinned project)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vendors
INWORLD_API_KEY=
GROQ_API_KEY=
# Only needed when testing the Deepgram STT presets
DEEPGRAM_API_KEY=

# Redis (Tier 1 hot memory), Sydney-pinned
REDIS_URL=

# Supabase Postgres (Sydney) — direct Postgres connection string, used by the
# backend's Python Postgres driver (not the Supabase JS/REST API)
SUPABASE_DB_URL=
