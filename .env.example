# Copy to .env and fill in real values locally. Never commit .env.
# Deployed environments read these from a secrets manager, not a file.
# Leaving a value empty (KEY=) counts as not set.

# Runtime behaviour (optional; defaults shown)
# ENVIRONMENT: development | production
ENVIRONMENT=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (DEBUG is refused in production)
LOG_LEVEL=INFO
# LOG_FORMAT: auto | console | json (auto = console in development, json in production)
LOG_FORMAT=auto

# LiveKit Cloud (Australia-pinned project)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vendors
INWORLD_API_KEY=
GROQ_API_KEY=
# Only needed when testing the Deepgram STT presets
DEEPGRAM_API_KEY=

# Redis (Tier 1 hot memory), Sydney-pinned
REDIS_URL=

# Supabase Postgres (Sydney) — direct Postgres connection string, used by the
# backend's Python Postgres driver (not the Supabase JS/REST API)
SUPABASE_DB_URL=
