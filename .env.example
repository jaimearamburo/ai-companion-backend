# Copy to .env and fill in real values locally. Never commit .env.
# Deployed environments read these from a secrets manager, not a file.
# Leaving a value empty (KEY=) counts as not set.

# Runtime behaviour (optional; defaults shown)
# ENVIRONMENT: development | production
ENVIRONMENT=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (DEBUG is refused in production)
LOG_LEVEL=INFO
# LOG_FORMAT: auto | console | json (auto = console in development, json in production)
LOG_FORMAT=auto

# LiveKit Cloud (Australian region; pinning needs a paid plan)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text: Deepgram (Australian endpoint is selected in code)
DEEPGRAM_API_KEY=

# LLMs (scriptwriter + safety) — both hosts are configured; each call's preset picks one
GROQ_API_KEY=
# Amazon Bedrock long-term API key, and the AWS region to call (Sydney)
BEDROCK_API_KEY=
BEDROCK_REGION=ap-southeast-2

# Optional: only needed if an Inworld preset is selected
INWORLD_API_KEY=

# Redis (Tier 1 hot memory), Upstash, Sydney — rediss:// (TLS) URL
REDIS_URL=

# Supabase Postgres (Sydney) — Postgres connection string used by the backend's
# Python driver (not the Supabase JS/REST API)
SUPABASE_DB_URL=
